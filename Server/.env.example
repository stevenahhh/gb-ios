# Copy to a private env file outside version control. Never commit real values.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_SSLMODE=verify-full
# Optional: run in a dedicated schema instead of the role's default search path.
# DATABASE_SCHEMA=roundup
ROUNDUP_API_KEY=replace-with-a-long-random-value
# Optional: DEBUG, INFO, WARNING, or ERROR.
# ROUNDUP_LOG_LEVEL=INFO
CLOVA_STUDIO_API_KEY=
NCP_CSR_CLIENT_ID=
NCP_CSR_CLIENT_SECRET=
# Optional: CLOVA Voice credentials when TTS runs on its own NAVER API app; /tts falls back to NCP_CSR_*.
# NCP_TTS_CLIENT_ID=
# NCP_TTS_CLIENT_SECRET=
# Optional: CLOVA Voice Premium speaker, default vyuna.
# TTS_SPEAKER=vyuna
NCP_MAPS_CLIENT_ID=
NCP_MAPS_CLIENT_SECRET=
# Optional: collectors. Without these the source reports needs_connection and makes no request.
# Instagram: only an account the operator of this server owns. Meta's review and webhook pages disagree, so
# try a tester account first; see README.md, Collectors.
# INSTAGRAM_ACCESS_TOKEN=
# INSTAGRAM_USER_ID=
# Smart Store: only when the operator of this server owns the store. Set the switch to exactly true; without it the
# credentials are ignored. Never put another store owner's key here. Naver's answers:
# https://github.com/commerce-api-naver/api-agency/discussions/809 (2026-03-04)
# https://github.com/commerce-api-naver/commerce-api/discussions/3967 (2026-11-09)
# NAVER_COMMERCE_SELF_OPERATED=true
# NAVER_COMMERCE_CLIENT_ID=
# NAVER_COMMERCE_CLIENT_SECRET=
