[Unit]
Description=Roundup API
After=network-online.target

[Service]
WorkingDirectory=/opt/roundup/current
EnvironmentFile=/opt/roundup/server.env
EnvironmentFile=/opt/roundup/current/db.env
ExecStart=/usr/local/bin/uv run --frozen --no-dev uvicorn main:app --host 0.0.0.0 --port 8787 --ssl-keyfile /opt/roundup/tls.key --ssl-certfile /opt/roundup/tls.crt
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
