[Unit]
Description=Roundup API
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=/opt/roundup/current
EnvironmentFile=/opt/roundup/server.env
EnvironmentFile=/opt/roundup/current/db.env
ExecStart=/opt/roundup/current/.venv/bin/uvicorn main:app --host 0.0.0.0 --port 8787 --no-access-log --ssl-keyfile /opt/roundup/tls.key --ssl-certfile /opt/roundup/tls.crt
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
