[Unit]
Description=Roundup API
After=network-online.target
Wants=network-online.target

[Service]
User=gongbang
Group=gongbang
WorkingDirectory=/opt/gongbang/current
EnvironmentFile=/opt/gongbang/server.env
ExecStart=/opt/gongbang/current/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000 --no-access-log
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
